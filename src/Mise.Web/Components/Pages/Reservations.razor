@page "/reservations"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using Mise.UI.Components
@using Mise.UI.Components.Primitives
@using Mise.UI.Abstractions
@inject IReservationsClient ReservationsClient
@inject IStringLocalizer<UiStrings> L

<PageTitle>@L["NavReservations"]</PageTitle>

<PageHeader Title="@L["NavReservations"]" />

<div class="mise-card p-4 mb-3">
    <ReservationForm ReservationsClient="ReservationsClient" OnCreated="HandleCreated" />
</div>

<h2 class="h6 fw-bold">Today's reservations</h2>

@if (_createdReservations.Count == 0)
{
    <p data-testid="@TestIds.DayListEmpty">No reservations yet.</p>
}
else
{
    <ul data-testid="@TestIds.DayList">
        @foreach (var reservation in _createdReservations)
        {
            <li data-testid="@TestIds.ReservationRow(reservation.Id)">@reservation.CustomerName — party of @reservation.PartySize</li>
        }
    </ul>
}

@code {
    private readonly List<ReservationDto> _createdReservations = [];

    private void HandleCreated(ReservationDto reservation) => _createdReservations.Add(reservation);
}
