<script type="module" src="@Assets["Components/Layout/NavMenu.razor.js"]"></script>

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Mise</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div id="nav-scrollable" class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reservations">
                        <span class="bi bi-calendar-check" aria-hidden="true"></span> Reservations
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <span data-testid="nav-current-user">@context.User.Identity?.Name</span>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="logout" data-testid="btn-logout">Sign out</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="login" data-testid="btn-login-nav">Sign in</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
