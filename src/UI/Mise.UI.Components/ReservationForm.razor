@namespace Mise.UI.Components

<form class="reservation-form" data-testid="@TestIds.ReservationForm" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault="true">
    <div class="mb-3">
        <label class="form-label" for="input-customer-name">Customer name</label>
        <input class="form-control" id="input-customer-name" data-testid="@TestIds.InputCustomerName" @bind="CustomerName" @bind:event="oninput" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="input-customer-phone">Phone number</label>
        <input class="form-control" id="input-customer-phone" data-testid="@TestIds.InputCustomerPhone" @bind="CustomerPhone" @bind:event="oninput" />
        @if (FieldErrors.TryGetValue("CustomerPhone", out var customerPhoneErrors))
        {
            <p class="text-danger small mt-1 mb-0" data-testid="@TestIds.ErrorCustomerPhone" role="alert">@customerPhoneErrors[0]</p>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" for="input-party-size">Party size</label>
        <input class="form-control" id="input-party-size" data-testid="@TestIds.InputPartySize" type="number" @bind="PartySizeText" @bind:event="oninput" />
        @if (FieldErrors.TryGetValue("PartySize", out var partySizeErrors))
        {
            <p class="text-danger small mt-1 mb-0" data-testid="@TestIds.ErrorPartySize" role="alert">@partySizeErrors[0]</p>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" for="input-reservation-date-time">Date and time</label>
        <input class="form-control" id="input-reservation-date-time" data-testid="@TestIds.InputReservationDateTime" type="datetime-local" @bind="ReservationDateTimeLocal" />
    </div>

    @if (UnexpectedError is not null)
    {
        <p class="text-danger small mt-1 mb-0" data-testid="@TestIds.ErrorUnexpected" role="alert">@UnexpectedError</p>
    }

    <button type="submit" class="btn btn-primary" data-testid="@TestIds.SubmitReservation">Create reservation</button>
</form>
