<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- IOptions<ReservationDefaultsOptions> — Decision #7's configured default turn time. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- Own Domain, Mise.SharedKernel(.Infrastructure) for IAuditWriter, Mise.Modules.Tables.Contracts
       for ITableAvailabilityLookup (BR-07, Phase 6), and — new in Phase 7 — this module's own
       Mise.Modules.Reservations.Contracts: SeatReservationCommandHandler/CancelReservationCommandHandler/
       MarkReservationNoShowCommandHandler construct the cross-module ReservationSeated/
       ReservationTableVacated events (ADR-007) directly, which have to live in Contracts to be
       visible to Tables.Application's handler — Domain cannot reference Contracts (CLAUDE.md's
       boundary table), so the Application layer is where the event is actually built. Other
       modules' Contracts are explicitly allowed too
       (ModuleBoundaryTests.Application_NeverReferencesAnotherModulesDomainApplicationOrInfrastructure
       forbids only another module's Domain/Application/Infrastructure); never EF Core, never
       ASP.NET Core. -->
  <ItemGroup>
    <ProjectReference Include="..\Mise.Modules.Reservations.Domain\Mise.Modules.Reservations.Domain.csproj" />
    <ProjectReference Include="..\Mise.Modules.Reservations.Contracts\Mise.Modules.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\Mise.Modules.Tables.Contracts\Mise.Modules.Tables.Contracts.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel\Mise.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel.Infrastructure\Mise.SharedKernel.Infrastructure.csproj" />
  </ItemGroup>

</Project>
