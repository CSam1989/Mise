<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Already available transitively via EF Core, but declared explicitly since this
         project uses ILogger<T>/[LoggerMessage] directly (CLAUDE.md's CPM philosophy: don't
         rely on an undeclared transitive dependency for something referenced by name). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Same CPM philosophy: PostgresException/PostgresErrorCodes (BR-01's exclusion-constraint
         violation, docs/plan.md correction #1) are referenced by name in ReservationsData. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <!-- Design-time only (dotnet-ef migrations add) — never needed at runtime. -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Own Domain + Application, Mise.SharedKernel(.Infrastructure) — no other module's
       anything (CLAUDE.md's boundary table). -->
  <ItemGroup>
    <ProjectReference Include="..\Mise.Modules.Reservations.Domain\Mise.Modules.Reservations.Domain.csproj" />
    <ProjectReference Include="..\Mise.Modules.Reservations.Application\Mise.Modules.Reservations.Application.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel\Mise.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel.Infrastructure\Mise.SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel.Persistence\Mise.SharedKernel.Persistence.csproj" />
  </ItemGroup>

</Project>
