<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!-- Already available transitively via EF Core, but declared explicitly since this
         project uses ILogger<T>/[LoggerMessage] directly (CLAUDE.md's CPM philosophy). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <!-- Design-time only (dotnet-ef migrations add) — never needed at runtime. -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Own Domain + Application, Mise.SharedKernel(.Infrastructure/.Persistence) — no other
       module's anything (CLAUDE.md's boundary table). Mise.ServiceDefaults is the one
       deliberate addition: JwtTokenIssuer needs the same Issuer/Audience/SigningKeyConfigKey
       constants Mise.ApiService validates against, and Mise.Web's placeholder token minting
       already referenced Mise.ServiceDefaults for exactly this reason before minting moved
       here in Phase 3 — see CLAUDE.md's updated boundary note. -->
  <ItemGroup>
    <ProjectReference Include="..\Mise.Modules.StaffIdentity.Domain\Mise.Modules.StaffIdentity.Domain.csproj" />
    <ProjectReference Include="..\Mise.Modules.StaffIdentity.Application\Mise.Modules.StaffIdentity.Application.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel\Mise.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel.Infrastructure\Mise.SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel.Persistence\Mise.SharedKernel.Persistence.csproj" />
    <ProjectReference Include="..\..\Mise.ServiceDefaults\Mise.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
