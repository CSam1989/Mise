<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Own Domain, Mise.SharedKernel(.Infrastructure) for IAuditWriter/IDomainEventHandler — never
       EF Core, never ASP.NET Core, never another module's Domain/Application/Infrastructure
       (ModuleBoundaryTests.Application_NeverReferencesAnotherModulesDomainApplicationOrInfrastructure).
       New in Phase 7: Mise.Modules.Reservations.Contracts, the mirror image of Reservations.
       Application's own Phase-6 reference to Tables.Contracts — this project's
       ReservationSeatedTableOccupiedHandler/ReservationTableVacatedHandler subscribe to
       Reservations' cross-module events and consume IReservationLookup (ADR-007), all declared
       there. Explicitly allowed: the boundary rule forbids another module's Domain/Application/
       Infrastructure, not its Contracts. -->
  <ItemGroup>
    <ProjectReference Include="..\Mise.Modules.Tables.Domain\Mise.Modules.Tables.Domain.csproj" />
    <ProjectReference Include="..\Mise.Modules.Reservations.Contracts\Mise.Modules.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel\Mise.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Mise.SharedKernel.Infrastructure\Mise.SharedKernel.Infrastructure.csproj" />
  </ItemGroup>

</Project>
