<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- IAuditWriter/AuditLogEntry still force nothing EF-specific onto consumers. Phase 7 adds
       two small, EF-free packages for DomainEventPublisher: DI abstractions (to resolve
       IDomainEventHandler<T> instances) and Logging abstractions (CLAUDE.md's [LoggerMessage]
       standard applies here too, same "declare it if you reference it by name" CPM convention
       used elsewhere). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mise.SharedKernel\Mise.SharedKernel.csproj" />
  </ItemGroup>

</Project>
