<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion entry here pin a *transitive* dependency's version
         even when no project has a direct PackageReference to it. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ASP.NET Core / Aspire -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>
  <!-- NOTE: Aspire.Hosting.AppHost is NOT listed here. The Aspire.AppHost.Sdk adds it as an
       *implicit* PackageReference, and CPM refuses to centrally version an implicit reference
       (NU1009) — its version is pinned by the Aspire.AppHost.Sdk version in Mise.AppHost.csproj
       (currently 13.5.3) instead. -->

  <!-- Mise.ServiceDefaults (OpenTelemetry / resilience / service discovery) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

  <!-- Testing — versions verified against FamilySplit's Directory.Packages.props. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Decision #8: this is a personal, non-commercial project, so FluentAssertions'
         post-v8 Xceed Community Licence applies — pin held at exactly this version
         rather than floated, since the license (not just the API) is being relied on. -->
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <!-- Mise.IntegrationTests — Testcontainers-backed PostgreSQL, real ADO.NET (no EF Core
       provider yet: no module has a DbContext until Phase 2, so Npgsql.EntityFrameworkCore.PostgreSQL
       is deferred until something actually needs it). -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <!-- Mise.Client.UnitTests — bUnit against the shared RCL. -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.11.3" />
    <!-- Transitive pin: bunit's own AngleSharp floor has historically trailed behind
         GHSA-pgww-w46g-26qg's fix; CentralPackageTransitivePinningEnabled forces this
         version regardless of what bunit itself references. -->
    <PackageVersion Include="AngleSharp" Version="1.8.1" />
  </ItemGroup>

  <!-- Mise.E2ETests — Playwright against the running Blazor host. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <!-- Deterministic time (non-negotiable rule in CLAUDE.md): FakeTimeProvider for every
       tier that touches time-dependent rules. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <!-- Aspire orchestration — Postgres resource added to Mise.AppHost in Phase 1 (1.7).
       Pinned to the same Aspire release as Aspire.Hosting.Testing above. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
  </ItemGroup>

  <!-- Phase 2 — the first module (Reservations) and its EF Core/Postgres persistence,
       FluentValidation, and the minimal placeholder JWT-bearer auth spine (docs/plan.md
       ADR-004's real StaffIdentity sign-in lands in Phase 3; this is only enough for the
       401/authenticated seam to be real). Versions verified against nuget.org at the time
       of adding, matched to the net10.0 target. -->
  <ItemGroup>
    <!-- Microsoft.EntityFrameworkCore(.Relational) pinned explicitly at the same patch as
         .Design below: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 and
         Microsoft.EntityFrameworkCore.Design 10.0.12 otherwise pull two different transitive
         EF Core versions, which CentralPackageTransitivePinningEnabled needs an explicit pin
         to unify (MSB3277 conflict without this). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- Phase 3 — StaffIdentity: ASP.NET Core Identity's EF Core stores. Pinned to the same
         10.0.12 patch as the rest of the ASP.NET Core / EF Core family above. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <!-- Structured logging standard (CLAUDE.md "Logging") — ILogger<T> + [LoggerMessage] in
         every non-Domain project, including ones with no other package reference. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
